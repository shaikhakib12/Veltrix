# ==============================================================================
# AWS SAM Configuration Example (samconfig.toml.example)
# Rename to samconfig.toml to customize local deployment parameters
# ==============================================================================

version = 0.1

[default]
[default.global.parameters]
stack_name = "veltrix-dev"

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "veltrix-dev"
region = "us-east-1"
parameter_overrides = "Environment=\"dev\""
image_repositories = []
