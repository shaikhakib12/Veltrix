{
  "version": "1.0.0",
  "name": "veltrix-development-hooks",
  "description": "Repetitive quality, security, and integrity hooks for VELTRIX development",
  "hooks": [
    {
      "id": "pre-commit-lint-test",
      "name": "Pre-Commit Lint & Unit Tests",
      "trigger": "pre-commit",
      "actions": [
        "npm --prefix backend run test:run",
        "npm --prefix frontend run lint"
      ],
      "haltOnError": true
    },
    {
      "id": "security-secret-scan",
      "name": "Zero-Credential Secret Scan",
      "trigger": "pre-push",
      "actions": [
        "node scripts/scan-secrets.js"
      ],
      "haltOnError": true
    },
    {
      "id": "audit-chain-integrity-check",
      "name": "Cryptographic Audit Chain Self-Check",
      "trigger": "post-build",
      "actions": [
        "node scripts/verify-audit-sample.js"
      ],
      "haltOnError": false
    }
  ]
}
