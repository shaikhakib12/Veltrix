# ==============================================================================
# VELTRIX Platform Configuration (.env.example)
# Copy this file to .env for local development
# NEVER commit production credentials or actual secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
ENVIRONMENT=dev
PORT=4000

# Storage & Infrastructure Mode (Options: 'memory' | 'aws')
# - 'memory': Uses in-memory MemoryStore for rapid offline local development & testing
# - 'aws': Connects to AWS services (DynamoDB, Cognito, SQS, EventBridge)
STORAGE_MODE=memory

# JWT & Authentication (Used in 'memory' simulation mode)
JWT_SECRET=veltrix-local-development-secret-change-in-production
JWT_EXPIRATION_SECONDS=3600

# AWS Cloud Configuration (Required only when STORAGE_MODE=aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS DynamoDB Tables
DYNAMODB_EVENTS_TABLE=Veltrix-SecurityEvents-dev
DYNAMODB_INCIDENTS_TABLE=Veltrix-Incidents-dev
DYNAMODB_RULES_TABLE=Veltrix-DetectionRules-dev
DYNAMODB_INDICATORS_TABLE=Veltrix-ThreatIndicators-dev
DYNAMODB_RESPONSES_TABLE=Veltrix-ResponseExecutions-dev
DYNAMODB_AUDIT_TABLE=Veltrix-AuditLogs-dev
DYNAMODB_AUDIT_STATE_TABLE=Veltrix-AuditState-dev

# AWS SQS FIFO Queues
SQS_AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/Veltrix-AuditLog-Queue.fifo
SQS_AUDIT_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/Veltrix-Audit-DLQ.fifo

# AWS Cognito (Authentication)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AWS S3 (Cryptographic Archival & WORM)
S3_AUDIT_ARCHIVE_BUCKET=veltrix-audit-archive-dev

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000/api/v1
