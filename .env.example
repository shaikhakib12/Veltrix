# VELTRIX Environment Configuration Template
# Copy this file to .env for local development

# Application Stage
NODE_ENV=development
PORT=4000

# AWS Configuration (Optional for Local Mock Mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_MockPoolId
COGNITO_APP_CLIENT_ID=mock_client_id_1234567890
COGNITO_DOMAIN=veltrix-auth.auth.us-east-1.amazoncognito.com

# Amazon DynamoDB Table Names
DYNAMODB_TABLE_EVENTS=Veltrix-SecurityEvents-dev
DYNAMODB_TABLE_RULES=Veltrix-DetectionRules-dev
DYNAMODB_TABLE_INCIDENTS=Veltrix-Incidents-dev
DYNAMODB_TABLE_INDICATORS=Veltrix-ThreatIndicators-dev
DYNAMODB_TABLE_RESPONSES=Veltrix-ResponseExecutions-dev
DYNAMODB_TABLE_AUDIT=Veltrix-AuditLogs-dev

# Amazon EventBridge
EVENTBRIDGE_BUS_NAME=veltrix-event-bus-dev

# Optional Threat Intelligence API Keys (Platform operates seamlessly without them)
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Local Mock Mode (Set to true to use local high-performance in-memory / storage adapter)
USE_LOCAL_MOCK_ADAPTER=true
