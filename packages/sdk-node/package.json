{
  "name": "@veltrix/sdk-node",
  "version": "1.0.0",
  "description": "Official Node.js SDK and Express middleware for VELTRIX Autonomous Website Defense",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@veltrix/shared": "*"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.8.7",
    "@types/supertest": "^7.2.1",
    "express": "^4.21.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}