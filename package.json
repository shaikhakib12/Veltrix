{
  "name": "veltrix-platform",
  "version": "1.0.0",
  "description": "VELTRIX: Autonomous Cyber Threat Detection & Response Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test:run --workspace=backend",
    "test:backend": "npm run test:run --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [
    "cybersecurity",
    "siem",
    "soar",
    "threat-detection",
    "aws-serverless",
    "mitre-attack",
    "react",
    "typescript"
  ],
  "author": "VELTRIX Security Team",
  "license": "Apache-2.0"
}
