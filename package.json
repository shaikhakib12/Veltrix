{
  "name": "veltrix-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VELTRIX — Autonomous Cyber Threat Detection & Response Platform",
  "author": "VELTRIX Team",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "cli"
  ],
  "scripts": {
    "pretypecheck": "npm run build --workspace=@veltrix/shared",
    "pretest": "npm run build --workspace=@veltrix/shared",
    "prebuild": "npm run build --workspace=@veltrix/shared",
    "build": "npm run build --workspaces --if-present",
